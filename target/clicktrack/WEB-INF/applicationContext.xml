<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        Ici on déclarera (stories suivantes) :
        - les repositories (InMemory...)       -> <bean>
        - les services (injection par <constructor-arg ref="..."/>)
        - le DataInitializer (init-method="init")
    -->

    <!-- 1. Repositories (Dernalhoum id sghir u m-gued m3a ref dial DataInitializer) -->
    <bean id="publisherRepository" class="ma.youcode.clickTrack.repository.implimentation.ImplimentationPublisherRepository"/>
    <bean id="lienRepository" class="ma.youcode.clickTrack.repository.implimentation.ImplimentationLienRepository"/>

    <!-- 2. Services (Guedna id f blacet is, u injectina l-repository) -->
    <bean id="publisherService" class="ma.youcode.clickTrack.service.implimentation.PublisherServiceImpl">
        <constructor-arg ref="publisherRepository"/>
    </bean>

    <!-- 3. DataInitializer (Ghadia t-kheddem ghir t-bda hit l-ref m-guedda daba) -->
    <bean id="dataInitializer" class="ma.youcode.clickTrack.init.DataInitializer" init-method="init">
        <constructor-arg ref="publisherRepository"/>
    </bean>


</beans>