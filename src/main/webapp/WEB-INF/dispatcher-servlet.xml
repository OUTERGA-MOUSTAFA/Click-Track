<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/mvc
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Active @RequestMapping/@GetMapping, @PathVariable, @ResponseBody, JSON (Jackson)... -->
    <mvc:annotation-driven/>

    <!-- Controllers déclarés en XML (pas de @Controller / pas de component-scan) -->

    <bean class="ma.youcode.clickTrack.controller.PublisherController">
        <constructor-arg ref="publisherService"/>
    </bean>

    <bean class="ma.youcode.clickTrack.controller.LienController">
        <constructor-arg ref="lienService"/>
    </bean>


    <bean class="ma.youcode.clickTrack.controller.OffreController">
        <constructor-arg  ref="lienService"/>
    </bean>


    <bean class="ma.youcode.clickTrack.controller.TrackingController">
        <constructor-arg  ref="lienService"/>
    </bean>




 <!-- L-handler howa li kay-9ol l Spring: NoSuchElementException → 404, IllegalArgumentException → 400. -->
    <bean class="ma.youcode.clickTrack.controller.GlobalExceptionHandler"/>
</beans>